{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "casa-en-orden",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HOME_REGISTRY",
        "class_name": "HomeRegistry"
      }
    ]
  },
  "exports": {
    "HomeRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
